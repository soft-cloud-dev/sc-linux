[Unit]
Description=SC Linux installation shell
DefaultDependencies=no
After=basic.target systemd-udev-trigger.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/scos-installer-shell
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
Restart=always
RestartSec=1
